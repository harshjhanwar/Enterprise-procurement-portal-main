# Production/deployment configuration example.
ConnectionStrings__DefaultConnection=Server=<server>;Database=EmployeeProcurementPlanning;User Id=<user>;Password=<strong-password>;TrustServerCertificate=True;
Jwt__Secret=<random-secret-at-least-32-characters>
Jwt__Issuer=EmployeeProcurementPlanning.Api
Jwt__Audience=EmployeeProcurementPlanning.Ui
Jwt__ExpirationMinutes=60
Cors__AllowedOrigins__0=https://app.example.com
Database__ApplyMigrationsOnStartup=false
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=<strong-unique-password>
BootstrapAdmin__DisplayName=System Administrator
SeedDemoData=false
